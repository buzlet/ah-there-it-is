AH_THERE_IT_IS_APP_NAME="Ah, There It Is!"
AH_THERE_IT_IS_ENV=development
AH_THERE_IT_IS_DATABASE_URL=sqlite:///./ah_there_it_is.db
AH_THERE_IT_IS_LLM_PROVIDER=heuristic
AH_THERE_IT_IS_AGENT_MAX_ROUNDS=8
AH_THERE_IT_IS_PROMPT_VERSION=inventory-v1
# Optional: point at an alternate system prompt for a live run.
# AH_THERE_IT_IS_PROMPT_FILE=./prompts/inventory-v2-strict.txt

# Real OpenAI-compatible provider (hosted or local):
# AH_THERE_IT_IS_LLM_PROVIDER=openai-compatible
# AH_THERE_IT_IS_LLM_PROVIDER_NAME=deepseek
# AH_THERE_IT_IS_LLM_BASE_URL=https://api.example.com
# AH_THERE_IT_IS_LLM_MODEL=provider-model-name
# AH_THERE_IT_IS_LLM_API_KEY=secret
# AH_THERE_IT_IS_LLM_TIMEOUT_SECONDS=60
# AH_THERE_IT_IS_LLM_MAX_RETRIES=2
# AH_THERE_IT_IS_LLM_RETRY_BACKOFF_SECONDS=1
# AH_THERE_IT_IS_LLM_MAX_RETRY_DELAY_SECONDS=60
# AH_THERE_IT_IS_LLM_TEMPERATURE=0
# Optional provider-specific top-level request fields as a JSON object.
# AH_THERE_IT_IS_LLM_EXTRA_BODY_JSON={"max_tokens":1024}

# Native Gemini provider:
# AH_THERE_IT_IS_LLM_PROVIDER=gemini
# AH_THERE_IT_IS_LLM_PROVIDER_NAME=gemini
# AH_THERE_IT_IS_LLM_MODEL=gemini-flash-latest
# AH_THERE_IT_IS_LLM_API_KEY=secret
# AH_THERE_IT_IS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
