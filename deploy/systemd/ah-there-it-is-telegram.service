[Unit]
Description=Ah There It Is Telegram poller
After=default.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=infinity
WorkingDirectory=%h/apps/ah-there-it-is/current
EnvironmentFile=%h/.local/state/ah-there-it-is/runtime.env
ExecStartPre=%h/apps/ah-there-it-is/current/.venv/bin/ah-there-it-is schema-check
ExecStart=%h/apps/ah-there-it-is/current/.venv/bin/ah-there-it-is telegram-bot
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
