{
  "version": "model-probes-v1",
  "cases": [
    {
      "id": "tool-search-basic",
      "messages": [
        {
          "role": "system",
          "content": "You are testing a tool API. Use the supplied tool when it is needed."
        },
        {
          "role": "user",
          "content": "Find GTX 1070 in my inventory."
        }
      ],
      "steps": [
        {
          "tools": [
            {
              "name": "search_items",
              "description": "Search inventory items by a natural-language query.",
              "input_schema": {
                "type": "object",
                "properties": {"query": {"type": "string"}},
                "required": ["query"],
                "additionalProperties": false
              }
            }
          ],
          "expect": {
            "tool_names": ["search_items"],
            "required_arguments": {"search_items": ["query"]}
          }
        }
      ]
    },
    {
      "id": "final-text-basic",
      "messages": [
        {
          "role": "system",
          "content": "Return a short plain-text answer. No tools are available."
        },
        {
          "role": "user",
          "content": "Reply with a short acknowledgement."
        }
      ],
      "steps": [
        {
          "tools": [],
          "expect": {
            "tool_names": [],
            "require_text": true
          }
        }
      ]
    },
    {
      "id": "tool-result-continuation",
      "messages": [
        {
          "role": "system",
          "content": "Use tools to answer. Continue from tool results and never invent IDs."
        },
        {
          "role": "user",
          "content": "Where is GTX 1070?"
        }
      ],
      "steps": [
        {
          "tools": [
            {
              "name": "search_items",
              "description": "Search inventory items.",
              "input_schema": {
                "type": "object",
                "properties": {"query": {"type": "string"}},
                "required": ["query"],
                "additionalProperties": false
              }
            }
          ],
          "expect": {
            "tool_names": ["search_items"],
            "required_arguments": {"search_items": ["query"]}
          },
          "tool_results": [
            {
              "tool_name": "search_items",
              "content": {
                "ok": true,
                "result": [{"id": 17, "name": "Gigabyte GTX 1070"}]
              }
            }
          ]
        },
        {
          "tools": [
            {
              "name": "get_item",
              "description": "Read an item by an ID returned by search.",
              "input_schema": {
                "type": "object",
                "properties": {"id": {"type": "integer"}},
                "required": ["id"],
                "additionalProperties": false
              }
            }
          ],
          "expect": {
            "tool_names": ["get_item"],
            "required_arguments": {"get_item": ["id"]},
            "argument_equals": {"get_item": {"id": 17}}
          },
          "tool_results": [
            {
              "tool_name": "get_item",
              "content": {
                "ok": true,
                "result": {
                  "id": 17,
                  "name": "Gigabyte GTX 1070",
                  "location_path": "Квартира / Балкон / Стеллаж / Полка 2"
                }
              }
            }
          ]
        },
        {
          "tools": [],
          "expect": {
            "tool_names": [],
            "require_text": true
          }
        }
      ]
    },
    {
      "id": "parallel-tool-calls",
      "messages": [
        {
          "role": "system",
          "content": "This is a tool-protocol test. When asked, call both independent tools in the same response."
        },
        {
          "role": "user",
          "content": "In one response, search for CH341A and search for the location Средний ящик."
        }
      ],
      "steps": [
        {
          "tools": [
            {
              "name": "search_items",
              "description": "Search inventory items.",
              "input_schema": {
                "type": "object",
                "properties": {"query": {"type": "string"}},
                "required": ["query"],
                "additionalProperties": false
              }
            },
            {
              "name": "search_locations",
              "description": "Search inventory locations.",
              "input_schema": {
                "type": "object",
                "properties": {"query": {"type": "string"}},
                "required": ["query"],
                "additionalProperties": false
              }
            }
          ],
          "expect": {
            "tool_names": ["search_items", "search_locations"],
            "required_arguments": {
              "search_items": ["query"],
              "search_locations": ["query"]
            }
          }
        }
      ]
    }
  ]
}
