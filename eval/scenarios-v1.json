      "case_id": "find-01",
      "steps": [
        {
          "expect_tools": [
            "search_items"
          ],
          "tool_calls": [
            {
              "name": "search_items",
              "arguments": {
                "query": "GTX 1070"
              }
            }
          ]
        },
        {
          "expect_tools": [
            "get_item"
          ],
          "expect_results": [
            {
              "tool_name": "search_items",
              "path": "result",
              "min_items": 1
            }
          ],
          "tool_calls": [
            {
              "name": "get_item",
              "arguments": {
                "id": "${tool:search_items:result.0.id}"
              }
            }
          ]
        },
        {
          "expect_results": [
            {
              "tool_name": "get_item",
              "path": "result.name",
              "equals": "Gigabyte GTX 1070"
            }
          ],
          "final": "GTX 1070 найдена в инвентаре."
        }
      ]
